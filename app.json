{
  "expo": {
    "scheme": "greendale",
    "userInterfaceStyle": "automatic",
    "orientation": "landscape",
    "web": {
      "output": "static"
    },
    "name": "Greendale",
    "slug": "greendale",
    "icon": "./assets/icon.png",
    "android": {
      "package": "games.greendale.play",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false,
          "skipOnboarding": true
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101418",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e51b52db-747f-416a-b030-afc2b67da0de"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e51b52db-747f-416a-b030-afc2b67da0de"
    }
  }
}